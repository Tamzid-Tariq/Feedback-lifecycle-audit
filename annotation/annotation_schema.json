{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RevGround independent human annotation export v2.0",
  "type": "array",
  "minItems": 50,
  "maxItems": 50,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "item_id",
      "transition_id",
      "packet_id",
      "annotator_id",
      "rubric_version",
      "original_validity",
      "target_state_t1",
      "lifecycle_label",
      "instructional_priority",
      "leakage_label",
      "evidence_ids",
      "confidence",
      "short_reason"
    ],
    "properties": {
      "item_id": {"type": "string", "pattern": "^DEV_[0-9]{3}$"},
      "transition_id": {"type": "string", "minLength": 1},
      "packet_id": {"type": "string", "minLength": 1},
      "annotator_id": {"enum": ["A01", "A02"]},
      "rubric_version": {"const": "v2.0"},
      "original_validity": {"enum": ["SUPPORTED", "REFUTED", "INDETERMINATE"]},
      "target_state_t1": {"enum": ["PRESENT", "RESOLVED", "INDETERMINATE", "NOT_APPLICABLE"]},
      "lifecycle_label": {"enum": ["KEEP", "RETIRE", "RETRACT", "UNSURE"]},
      "instructional_priority": {"enum": ["HIGH", "LOW", "UNKNOWN"]},
      "leakage_label": {"enum": ["ABSENT", "PRESENT", "NOT_EVALUATED"]},
      "evidence_ids": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1}
      },
      "confidence": {"type": "integer", "minimum": 1, "maximum": 5},
      "short_reason": {"type": "string", "minLength": 1}
    }
  }
}
